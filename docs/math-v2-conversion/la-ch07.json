    },
    {
      "type": "heading",
      "id": "la-ch07-item-1-1-5",
      "sourceStart": 1393,
      "sourceEnd": 1520,
      "original": "#### 1.1.5. <span style=\"color: red\">(Skew-adjoint)</span> An operator $T\\in\\mathcal{L}(V)$ is called skew-adjoint if $T^*=-T$.",
      "action": "moved-to-item-title-and-statement"
    },
