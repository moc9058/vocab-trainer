    },
    {
      "type": "heading",
      "id": "la-ch07-item-1-1-4",
      "sourceStart": 1269,
      "sourceEnd": 1391,
      "original": "#### 1.1.4. <span style=\"color: red\">(Normal)</span> An operator $T\\in\\mathcal{L}(V)$ is called **normal** if $TT^*=T^*T$.",
      "action": "moved-to-item-title-and-statement"
    },
    {
      "type": "body",
      "blockId": "la-ch07-block-0007",
      "sourceStart": 1391,
      "sourceEnd": 1393,
