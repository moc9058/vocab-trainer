    },
    {
      "type": "heading",
      "id": "la-ch03-item-2-2-5",
      "sourceStart": 9780,
      "sourceEnd": 9830,
      "original": "#### 2.2.5. Suppose $T \\in \\mathcal{L}(V,W)$. Then",
      "action": "moved-to-item-title-and-statement"
    },
