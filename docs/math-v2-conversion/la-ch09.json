    {
      "type": "heading",
      "id": "la-ch09-item-2-3-9",
      "sourceStart": 10484,
      "sourceEnd": 10589,
      "original": "#### 2.3.9. <span style=\"color: red\">(Vandermonde matrix)</span> Let $\\beta_1,\\ldots,\\beta_n \\in F$. Then",
      "action": "moved-to-item-title-and-statement"
    },
