{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vocab-trainer.local/schemas/chinese-grammar-create.v1.schema.json",
  "title": "Chinese grammar smart-add request v1",
  "description": "Recommended external-client request profile for POST /api/grammar/chinese/smart-add. Korean-only or Japanese-only descriptions are accepted. Supplied language entries are preserved and missing Japanese/Korean descriptions are generated. IDs are assigned by the client; reusing an existing ID can overwrite that record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "statement",
    "descriptions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^grammar-chinese-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "External-client convention: grammar-chinese- followed by a fresh lowercase UUID v4. This is a client convention, not a server-enforced idempotency key."
    },
    "statement": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Chinese grammar pattern. Use + and … for structure and variable slots, e.g. 把+O+V."
    },
    "transliteration": {
      "type": "string",
      "description": "Statement pinyin: lowercase with tone marks for Chinese pieces (neutral-tone syllables remain unmarked); preserve +, …, punctuation and non-Chinese placeholders. Omit to let the server generate."
    },
    "descriptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "partOfSpeech",
          "text"
        ],
        "properties": {
          "partOfSpeech": {
            "const": "",
            "description": "Compatibility field retained for grammar. Send an empty string; word part-of-speech fields are removed."
          },
          "text": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "ja": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "ko": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "minProperties": 1
          },
          "pinyins": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Example"
      }
    },
    "level": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    }
  },
  "$defs": {
    "Example": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sentence",
        "translation"
      ],
      "properties": {
        "sentence": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Chinese example sentence, preserving the original text."
        },
        "translation": {
          "description": "A translation string or ISO-code-keyed translations. Empty string asks the server to fill missing translations.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          ]
        },
        "userSplits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "description": "Optional word segmentation as ordered surface texts. Preserve the sentence exactly; the server fills readings and references."
        }
      }
    }
  },
  "examples": [
    {
      "id": "grammar-chinese-f6c2e6bc-3189-42e1-93e9-93aefda6c915",
      "statement": "把+O+V",
      "descriptions": [
        {
          "partOfSpeech": "",
          "text": {
            "ko": "목적어를 把 뒤, 동사 앞에 놓아 그 대상에 대한 처리나 결과를 나타낸다."
          }
        }
      ]
    },
    {
      "id": "grammar-chinese-f6c2e6bc-3189-42e1-93e9-93aefda6c915",
      "statement": "把+O+V",
      "transliteration": "bǎ+O+V",
      "descriptions": [
        {
          "partOfSpeech": "",
          "text": {
            "ko": "목적어를 把 뒤, 동사 앞에 놓아 그 대상에 대한 처리나 결과를 나타낸다."
          }
        }
      ],
      "examples": [
        {
          "sentence": "我把书放在桌子上了。",
          "translation": {
            "ko": "나는 책을 책상 위에 놓았다."
          }
        }
      ],
      "level": "HSK4",
      "tags": [
        "把字句"
      ]
    }
  ]
}
