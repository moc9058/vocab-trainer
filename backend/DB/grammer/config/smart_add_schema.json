{
  "name": "grammar_descriptions",
  "strict": false,
  "schema": {
    "type": "object",
    "required": [
      "descriptions"
    ],
    "properties": {
      "descriptions": {
        "type": "array",
        "description": "Enriched descriptions with full language coverage. Same length, order, and partOfSpeech as the user input.",
        "items": {
          "type": "object",
          "required": [
            "partOfSpeech",
            "text"
          ],
          "properties": {
            "partOfSpeech": {
              "type": "string",
              "description": "Preserved verbatim from the user input."
            },
            "pinyins": {
              "type": "array",
              "description": "Preserved verbatim from the user input (Chinese only).",
              "items": {
                "type": "string"
              }
            },
            "text": {
              "type": "object",
              "description": "Description text keyed by language code. Japanese (ja) and Korean (ko) are required and must express the same meaning as the supplied description.",
              "additionalProperties": {
                "type": "string"
              },
              "required": [
                "ja",
                "ko"
              ],
              "properties": {
                "ja": {
                  "type": "string",
                  "minLength": 1
                },
                "ko": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
