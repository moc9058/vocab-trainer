{
  "name": "article_import_analysis",
  "strict": true,
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "paragraphs"
    ],
    "properties": {
      "paragraphs": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sentences"
          ],
          "properties": {
            "sentences": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "text",
                  "translation",
                  "words",
                  "grammar"
                ],
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "translation": {
                    "type": "string"
                  },
                  "words": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "term",
                        "transliteration",
                        "meaning"
                      ],
                      "properties": {
                        "term": {
                          "type": "string"
                        },
                        "transliteration": {
                          "type": "string"
                        },
                        "meaning": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "grammar": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "statement",
                        "description",
                        "excerpt"
                      ],
                      "properties": {
                        "statement": {
                          "type": "string"
                        },
                        "description": {
                          "type": "string"
                        },
                        "excerpt": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
