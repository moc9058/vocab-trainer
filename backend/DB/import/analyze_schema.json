{
  "name": "article_import_analysis",
  "strict": true,
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "paragraphs"
    ],
    "properties": {
      "paragraphs": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sentences"
          ],
          "properties": {
            "sentences": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "text",
                  "translation",
                  "words",
                  "grammar",
                  "overview",
                  "explanationLanguage",
                  "ambiguityNotes",
                  "comprehension"
                ],
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "translation": {
                    "type": "string"
                  },
                  "words": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "term",
                        "transliteration",
                        "meaning",
                        "surface",
                        "partOfSpeech",
                        "role",
                        "reasoning",
                        "contrast",
                        "senseKey",
                        "occurrence"
                      ],
                      "properties": {
                        "term": {
                          "type": "string"
                        },
                        "transliteration": {
                          "type": "string"
                        },
                        "meaning": {
                          "type": "string"
                        },
                        "surface": {
                          "type": "string"
                        },
                        "partOfSpeech": {
                          "type": "string"
                        },
                        "role": {
                          "type": "string"
                        },
                        "reasoning": {
                          "type": "string"
                        },
                        "contrast": {
                          "type": "string"
                        },
                        "senseKey": {
                          "type": "string"
                        },
                        "occurrence": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    }
                  },
                  "grammar": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "statement",
                        "description",
                        "excerpt",
                        "roleInSentence",
                        "elements"
                      ],
                      "properties": {
                        "statement": {
                          "type": "string"
                        },
                        "description": {
                          "type": "string"
                        },
                        "excerpt": {
                          "type": "string"
                        },
                        "roleInSentence": {
                          "type": "string"
                        },
                        "elements": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "wordIndices",
                              "role",
                              "explanation",
                              "fixed"
                            ],
                            "properties": {
                              "wordIndices": {
                                "type": "array",
                                "items": {
                                  "type": "integer",
                                  "minimum": 0
                                }
                              },
                              "role": {
                                "type": "string"
                              },
                              "explanation": {
                                "type": "string"
                              },
                              "fixed": {
                                "type": "boolean"
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "overview": {
                    "type": "string"
                  },
                  "explanationLanguage": {
                    "type": "string"
                  },
                  "ambiguityNotes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "comprehension": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "meaning",
                      "skeleton",
                      "connection",
                      "nuances"
                    ],
                    "properties": {
                      "meaning": {
                        "type": "string"
                      },
                      "skeleton": {
                        "type": "string"
                      },
                      "connection": {
                        "type": "string"
                      },
                      "nuances": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "text",
                            "evidence",
                            "certainty"
                          ],
                          "properties": {
                            "text": {
                              "type": "string"
                            },
                            "evidence": {
                              "type": "string"
                            },
                            "certainty": {
                              "type": "string",
                              "enum": [
                                "explicit",
                                "inferred",
                                "uncertain"
                              ]
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
