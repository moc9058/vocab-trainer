{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "subjectId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"
    },
    "chapterId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "local-notes",
            "migration",
            "author",
            "local-ocr"
          ]
        },
        "originalFile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "originalSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "urls": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https?://",
            "maxLength": 2000
          },
          "minItems": 0,
          "maxItems": 100
        },
        "originalHeadings": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 10000
          },
          "minItems": 0,
          "maxItems": 10000
        }
      },
      "required": [
        "kind",
        "originalFile",
        "originalSha256"
      ]
    },
    "content": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/content"
      },
      "minItems": 0,
      "maxItems": 10000
    }
  },
  "required": [
    "schemaVersion",
    "subjectId",
    "chapterId",
    "title",
    "source",
    "content"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vocab-trainer.local/math-chapter.schema.json",
  "$defs": {
    "block": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "block"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"
        },
        "format": {
          "const": "markdown"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 524288
        }
      },
      "required": [
        "type",
        "id",
        "format",
        "text"
      ]
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "section"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "label": {
          "type": "string",
          "maxLength": 100
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 300
          },
          "minItems": 0,
          "maxItems": 100
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/content"
          },
          "minItems": 0,
          "maxItems": 2000
        }
      },
      "required": [
        "type",
        "id",
        "title",
        "content"
      ]
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "item"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"
        },
        "kind": {
          "enum": [
            "definition",
            "theorem",
            "lemma",
            "proposition",
            "corollary",
            "axiom",
            "example",
            "remark",
            "exercise",
            "proof"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "label": {
          "type": "string",
          "maxLength": 100
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 300
          },
          "minItems": 0,
          "maxItems": 100
        },
        "content": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/block"
              },
              {
                "$ref": "#/$defs/item"
              }
            ]
          },
          "minItems": 0,
          "maxItems": 2000
        },
        "provesItemId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"
        },
        "learning": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "capabilities": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "recognize",
                  "apply",
                  "prove"
                ]
              },
              "minItems": 1,
              "maxItems": 3
            },
            "requires": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "itemId": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"
                  },
                  "capability": {
                    "type": "string",
                    "enum": [
                      "recognize",
                      "apply",
                      "prove"
                    ]
                  }
                },
                "required": [
                  "itemId",
                  "capability"
                ]
              },
              "minItems": 0,
              "maxItems": 1000
            },
            "proofCoverage": {
              "enum": [
                "none",
                "sketch",
                "complete"
              ]
            }
          },
          "required": [
            "capabilities",
            "requires",
            "proofCoverage"
          ]
        },
        "objectives": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 524288
              },
              "assessedCapabilities": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "conceptId": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"
                    },
                    "capability": {
                      "type": "string",
                      "enum": [
                        "recognize",
                        "apply",
                        "prove"
                      ]
                    }
                  },
                  "required": [
                    "conceptId",
                    "capability"
                  ]
                },
                "minItems": 1,
                "maxItems": 1000
              },
              "additionalPrerequisites": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "allOf": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "conceptId": {
                          "type": "string",
                          "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"
                        },
                        "capability": {
                          "type": "string",
                          "enum": [
                            "recognize",
                            "apply",
                            "prove"
                          ]
                        }
                      },
                      "required": [
                        "conceptId",
                        "capability"
                      ]
                    },
                    "minItems": 0,
                    "maxItems": 1000
                  },
                  "anyOf": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"
                        },
                        "priority": {
                          "type": "integer"
                        },
                        "requires": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "conceptId": {
                                "type": "string",
                                "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"
                              },
                              "capability": {
                                "type": "string",
                                "enum": [
                                  "recognize",
                                  "apply",
                                  "prove"
                                ]
                              }
                            },
                            "required": [
                              "conceptId",
                              "capability"
                            ]
                          },
                          "minItems": 1,
                          "maxItems": 1000
                        }
                      },
                      "required": [
                        "id",
                        "priority",
                        "requires"
                      ]
                    },
                    "minItems": 0,
                    "maxItems": 50
                  }
                },
                "required": [
                  "allOf",
                  "anyOf"
                ]
              },
              "assessmentBlockIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"
                },
                "minItems": 1,
                "maxItems": 1000
              },
              "difficultyRange": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5
                },
                "minItems": 2,
                "maxItems": 2
              },
              "proofRequirement": {
                "enum": [
                  "none",
                  "sketch",
                  "complete"
                ]
              },
              "proofSupport": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "coverage": {
                    "enum": [
                      "none",
                      "sketch",
                      "complete"
                    ]
                  },
                  "blockIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"
                    },
                    "minItems": 0,
                    "maxItems": 1000
                  }
                },
                "required": [
                  "coverage",
                  "blockIds"
                ]
              },
              "readiness": {
                "enum": [
                  "ready",
                  "blocked",
                  "reference-only"
                ]
              }
            },
            "required": [
              "id",
              "description",
              "assessedCapabilities",
              "additionalPrerequisites",
              "assessmentBlockIds",
              "difficultyRange",
              "proofRequirement",
              "proofSupport",
              "readiness"
            ]
          },
          "minItems": 0,
          "maxItems": 200
        }
      },
      "required": [
        "type",
        "id",
        "kind",
        "content"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "proof"
              }
            }
          },
          "then": {
            "required": [
              "provesItemId"
            ]
          }
        }
      ]
    },
    "content": {
      "anyOf": [
        {
          "$ref": "#/$defs/block"
        },
        {
          "$ref": "#/$defs/section"
        },
        {
          "$ref": "#/$defs/item"
        }
      ]
    }
  }
}
