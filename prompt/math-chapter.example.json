          "kind": "definition",
          "label": "1.1",
          "content": [
            {
              "type": "block",
              "id": "example-subspace-body",
              "format": "markdown",
              "text": "A subset $U$ of $V$ is a subspace when $U$ is a vector space with the same addition and scalar multiplication as $V$."
            }
          ],
