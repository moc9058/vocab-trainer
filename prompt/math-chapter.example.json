      "id": "example-context",
      "format": "markdown",
      "text": "Let $V$ be a vector space over $F$. All subspaces use the same scalar field."
    },
    {
      "type": "section",
      "id": "example-definitions",
      "title": "Definitions",
      "label": "1",
      "content": [
        {
          "type": "item",
