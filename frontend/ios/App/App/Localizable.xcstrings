            "value": "Copied text"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーした文章"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사한 글"
          }
        }
      }
    },
    "Open reading input": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open reading input"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み解く文章を入力"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽을 글 입력"
          }
        }
      }
    },
    "Source URL": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Source URL"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出典URL"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "출처 URL"
          }
        }
      }
    },
    "Open text input when no selected text was received. Copy or share the passage, or use a screenshot.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open text input when no selected text was received. Copy or share the passage, or use a screenshot."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した文章が届かない場合に入力画面を開きます。文章をコピー・共有するか、スクリーンショットを使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 글을 받지 못했을 때 입력 화면을 엽니다. 글을 복사 또는 공유하거나 스크린샷을 사용하세요。"
          }
        }
      }
    },
    "CAPTURE_INVALID": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot open this input. Check the text or image format and size."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力を開けません。文章や画像の形式・サイズを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력을 열 수 없습니다. 글이나 이미지의 형식과 크기를 확인하세요."
          }
        }
      }
    },
    "CAPTURE_FULL": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The temporary inbox is full. Delete unused inputs in the app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時受信箱がいっぱいです。アプリで不要な入力を削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "임시 수신함이 가득 찼습니다. 앱에서 불필요한 입력을 삭제하세요."
          }
        }
      }
    },
    "CAPTURE_EXPIRED": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This input has expired. Capture or share the passage again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力の保存期限が切れました。文章や画像をもう一度取得してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력의 저장 기한이 지났습니다. 글이나 이미지를 다시 가져오세요."
          }
        }
      }
    },
    "CAPTURE_LOCKED": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock the device and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末のロックを解除して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 잠금을 해제하고 다시 시도하세요."
          }
        }
      }
    },
    "CAPTURE_TOO_LONG": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text is limited to 8,000 UTF-16 units. Share one paragraph at a time."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文章は8,000文字までです。段落単位に分けて共有してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "글은 8,000자까지 지원합니다. 문단별로 나누어 공유하세요."
          }
        }
      }
    },
    "CAPTURE_CHINESE_UNAVAILABLE": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chinese text recognition is unavailable. Share or paste the text instead."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末では中国語の文字認識を利用できません。文章を共有・貼り付けしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서는 중국어 문자 인식을 사용할 수 없습니다. 글을 공유하거나 붙여넣으세요."
          }
        }
      }
    }
  },
  "version": "1.0"
}
