server {
    listen 5173;
    # A variable proxy_pass resolves at request time through THIS resolver, so it
    # must be one that can see the backend hostname: public DNS (the Dockerfile's
    # 8.8.8.8 default) for the *.run.app URL on Cloud Run, Docker's embedded DNS
    # (127.0.0.11, set by docker-compose) for the `backend` service name locally.
    resolver ${DNS_RESOLVER} valid=30s;

    root /usr/share/nginx/html;
    index index.html;

    # The quiz screens hydrate a whole session's questions up front so a mid-quiz
    # connection drop can't interrupt them. That payload is large, highly repetitive
    # JSON; gzip is what keeps it cheap on a weak mobile connection.
    gzip on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types application/json application/javascript text/css text/plain image/svg+xml;
    gzip_vary on;

    location /api/ {
        set $backend ${BACKEND_URL};
        proxy_pass $backend;
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        # Host above is rewritten to the upstream, so the public hostname would
        # otherwise be lost. The OAuth callback needs it: Cloud Run serves this app
        # on two hostnames and the flow must return to the one it started on.
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 600s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
