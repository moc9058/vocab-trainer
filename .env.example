# Copy to .env and fill in. The root .env is read by backend/src (dotenv) and by
# every backend/scripts/*.ts invocation, locally and during deploy config uploads.

# OpenAI — required for LLM features (smart-add, translation, speaking/writing, import).
# Leave unset to run the app without LLM features.
OPENAI_API_KEY=
OPENAI_MODEL_MINI=
OPENAI_MODEL_FULL=
# Only if using Azure OpenAI
AZURE_OPENAI_API_VERSION=

# GCP project holding the Firestore database (scripts default to vocab-trainer-490014)
FIRESTORE_PROJECT=vocab-trainer-490014
# FIRESTORE_DATABASE_ID=vocab-database

# NEVER set FIRESTORE_EMULATOR_HOST in this file. `deploy.sh --llm/--auth/--prompts`
# runs scripts that read this file and MUST write to production Firestore; with the
# emulator host set here, those uploads would silently land in the local emulator.
# The local entrypoints (npm run dev:local, npm run seed:load, docker compose) set
# the variable themselves.
